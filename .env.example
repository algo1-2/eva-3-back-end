# Copia este archivo como ".env" y ajusta los valores.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (SQLite por defecto)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# Solo para otros motores (PostgreSQL / MySQL):
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
